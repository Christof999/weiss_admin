# ─────────────────────────────────────────────────────────────
# Weiß Forst GbR – Admin PWA – Umgebungsvariablen
# Kopiere diese Datei zu ".env" und trage die echten Werte ein.
# Alle VITE_*-Variablen sind im Browser sichtbar (nicht geheim).
# Die Sicherheit beruht auf Firebase Auth + Firestore/Storage Security Rules.
# ─────────────────────────────────────────────────────────────

# Firebase Web-Config (identisch zur Website – Firebase Console > Projekteinstellungen)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging – Web Push Zertifikat (VAPID Public Key)
# Firebase Console > Projekteinstellungen > Cloud Messaging > Web-Konfiguration
VITE_FIREBASE_VAPID_KEY=

# Google Maps JavaScript API Key (für den Arbeitsbereich-Editor)
# Benötigt aktivierte APIs: Maps JavaScript API + Drawing + Geometry Library
VITE_GOOGLE_MAPS_API_KEY=
