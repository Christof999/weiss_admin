{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!firebase-messaging-sw.js|sw.js|manifest.webmanifest|icons/.*|logo.jpeg|assets/.*).*)", "destination": "/index.html" }
  ]
}
